# SM7475 mainline early bring-up / diagnostic fragment
# Merge on top of arm64_defconfig (or the project's arm64 base config).
# Keep storage, PHY, watchdog, console, and gadget paths built in so an
# initramfs does not depend on modules that are unavailable at first boot.

# Early diagnostics and persistent crash logs
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_LOG_BUF_SHIFT=19
CONFIG_PSTORE=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Turn an oops into a reportable panic; panic= on the boot command line may
# override this. PANIC_TIMEOUT=0 deliberately leaves the panic screen/log
# available until the bootloader or the caller resets the device.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=0

# Qualcomm watchdog and its core, built in for an already-running boot WDT.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# Qualcomm serial console (the DTS selects the GENI UART as stdout-path).
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# UFS boot storage and Qualcomm QMP UFS PHY.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# USB gadget/ADB-style diagnostic console prerequisites.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
