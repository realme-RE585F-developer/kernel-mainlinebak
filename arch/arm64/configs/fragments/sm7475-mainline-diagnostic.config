# SM7475 mainline early bring-up / diagnostic fragment
# Merge on top of arm64_defconfig (or the project's arm64 base config).
# Keep storage, PHY, console, and gadget paths built in so an initramfs does
# not depend on modules that are unavailable at first boot.  This fragment is
# used with a vendor boot chain, so early bring-up must not take ownership of
# firmware-managed watchdog, IOMMU, or power-controller blocks prematurely.

# Use fixed kernel addresses while validating the boot handoff.  This removes
# one variable from early exception and framebuffer diagnostics.
# CONFIG_RANDOMIZE_BASE is not set

# Early diagnostics and persistent crash logs
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_LOG_BUF_SHIFT=19
CONFIG_PSTORE=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Keep early exceptions observable.  The boot command line can still request a
# deliberate panic once the handoff is known to work.
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set

# Do not claim the bootloader's watchdog during early bring-up.  The firmware
# owns this timer and an incomplete vendor DTB can otherwise cause a reset
# before the console is available.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_QCOM_WDT is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# The vendor DTB contains firmware-specific power and IOMMU nodes which are
# not yet described by the mainline board support.  Leave them bypassed until
# the basic kernel/console handoff is stable.
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_QCOM_RPMHPD is not set
# CONFIG_QCOM_SMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set

# Qualcomm serial console (the DTS selects the GENI UART as stdout-path).
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# Keep a bootloader-provided linear framebuffer usable for early text output.
CONFIG_FB=y
# The legacy simplefb path conflicts with simpledrm; keep the former for
# bootloader-provided framebuffers on this handset.
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y

# UFS boot storage and Qualcomm QMP UFS PHY.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# USB gadget/ADB-style diagnostic console prerequisites.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
